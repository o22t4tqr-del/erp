# 数据库连接（blitz.cloud → 应用 → Environment 里逐条添加；也可以整段粘贴）
# 代码会自动识别这些名字，DB_* 或 MYSQL_* 都行；手填的优先于平台注入的 DATABASE_URL
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# 空库留 1：首次启动自动导入 erp.sql（25 张表 + admin）；已有数据的老库设 0
AUTO_INIT_SCHEMA=1

# 可选
# DATABASE_URL=mysql://user:pass@host:3306/db
# DB_DEBUG=0
# DB_INIT_STRICT=1
# WAIT_DB_SECONDS=120
# TZ=Asia/Shanghai
